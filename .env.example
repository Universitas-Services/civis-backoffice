# Backoffice interno — configuración
# Copiar a .env.local:  cp .env.example .env.local
#
# La sesión se guarda en una cookie HttpOnly que el navegador no puede leer.
# El token de acceso NUNCA llega al cliente: las llamadas a la API salen
# desde el servidor de Next.

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_DOCUMENT_ORIGIN=http://localhost:9000
# URL que usa el servidor de Next para hablar con la API (puede diferir de la
# pública si la API vive en una red interna).
API_INTERNAL_URL=http://localhost:3001/api/v1

NEXT_PUBLIC_APP_NAME="Panel operativo"
SESSION_COOKIE_NAME=cp_bo_session
# CHANGE_ME: generar con `openssl rand -base64 48`
SESSION_SECRET=CHANGE_ME_secreto_de_sesion_solo_desarrollo_0001
